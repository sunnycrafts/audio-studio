<Application x:Class="AudioStudio.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:AudioStudio.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <local:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <local:NullToVisibilityConverter x:Key="NullToVisibility" />
            <local:InverseBoolConverter x:Key="InverseBool" />
            <local:SeverityToBrushConverter x:Key="SeverityToBrush" />
            <local:SeverityToGlyphConverter x:Key="SeverityToGlyph" />
            <local:HealthToBrushConverter x:Key="HealthToBrush" />
            <local:BoolToOpacityConverter x:Key="BoolToOpacity" />
            <local:StepStateToBrushConverter x:Key="StepStateToBrush" />
            <local:StepStateToGlyphConverter x:Key="StepStateToGlyph" />
            <local:MetricToBrushConverter x:Key="MetricToBrush" />

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Opacity" Value="0.65" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

            <Style x:Key="Muted" TargetType="TextBlock">
                <Setter Property="Opacity" Value="0.7" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Colour carries meaning only for severity and outcome. Everything
                 else stays neutral so those two actually draw the eye. -->
            <SolidColorBrush x:Key="AccentSuccess" Color="#4CD986" />
            <SolidColorBrush x:Key="AccentWarning" Color="#FFC84A" />
            <SolidColorBrush x:Key="AccentCritical" Color="#FF5552" />
            <SolidColorBrush x:Key="AccentInfo" Color="#63B3FF" />
            <SolidColorBrush x:Key="PanelTint" Color="#14FFFFFF" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
